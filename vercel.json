{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bunx bun@1.4.0 install --frozen-lockfile",
  "buildCommand": "bun run site:build",
  "outputDirectory": "apps/docs/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/docs", "destination": "/docs/introduction", "permanent": true },
    { "source": "/ko/docs", "destination": "/ko/docs/introduction", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/ko/index", "destination": "/ko", "permanent": true },
    { "source": "/docs/introduction/index", "destination": "/docs/introduction", "permanent": true },
    { "source": "/ko/docs/introduction/index", "destination": "/ko/docs/introduction", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ko/docs/introduction",
      "destination": "/ko/docs/introduction/index"
    },
    {
      "source": "/ko",
      "destination": "/ko/index"
    },
    {
      "source": "/docs/introduction",
      "destination": "/docs/introduction/index"
    }
  ]
}
