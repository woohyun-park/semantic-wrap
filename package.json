{
  "name": "semantic-wrap",
  "private": true,
  "author": "Woohyun Park",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woohyun-park/semantic-wrap.git"
  },
  "homepage": "https://github.com/woohyun-park/semantic-wrap#readme",
  "bugs": {
    "url": "https://github.com/woohyun-park/semantic-wrap/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run clean && tsc -b tsconfig.build.json",
    "bench:core": "bun scripts/benchmark-optimal-layouts.ts",
    "bench:react": "bun run site:build && SEMANTIC_WRAP_BENCHMARK=1 playwright test tests/browser/performance.spec.ts --project=chromium --workers=1 --reporter=line",
    "changeset": "changeset",
    "ai-docs:check": "bun scripts/sync-ai-docs.ts --check",
    "ai-docs:sync": "bun scripts/sync-ai-docs.ts",
    "check": "bun run release:verify && bun run examples:check && bun run ai-docs:check && bun run typecheck && bun run test && bun run build && bun run test:browser && bun run pack:check && bun run lint:packages",
    "clean": "rm -rf packages/core/dist packages/en/dist packages/react/dist packages/ko/dist .cache/core.tsbuildinfo .cache/en.tsbuildinfo .cache/react.tsbuildinfo .cache/ko.tsbuildinfo",
    "examples:check": "bun scripts/sync-example-docs.ts --check",
    "examples:sync": "bun scripts/sync-example-docs.ts",
    "lint:packages": "publint packages/core && publint packages/en && publint packages/ko && publint packages/react",
    "pack:check": "bun run --filter '@semantic-wrap/*' pack:check",
    "publish:core": "npm publish --workspace @semantic-wrap/core --access public",
    "publish:en": "npm publish --workspace @semantic-wrap/en --access public",
    "publish:ko": "npm publish --workspace @semantic-wrap/ko --access public",
    "publish:react": "npm publish --workspace @semantic-wrap/react --access public",
    "smoke:packages": "node scripts/verify-package-consumer.mjs",
    "smoke:published": "node scripts/verify-package-consumer.mjs --published",
    "site:build": "bun run --cwd apps/docs build",
    "site:dev": "bun run --cwd apps/docs dev",
    "site:preview": "bun run --cwd apps/docs preview",
    "site:typecheck": "bun run --cwd apps/docs typecheck",
    "test": "bun test packages scripts",
    "test:browser": "bun run site:build && playwright test",
    "typecheck": "tsc --noEmit",
    "version:packages": "changeset version && bun install --lockfile-only",
    "release": "bun run build && changeset publish",
    "release:guard": "bun scripts/verify-changeset-required.ts",
    "release:verify": "node scripts/verify-release-sync.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "publint": "0.3.24",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
